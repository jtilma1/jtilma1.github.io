# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# UniFi Access Configuration
# Choose ONE of the following modes:

# ===== MODE 1: LOCAL CONTROLLER (at same location as bot) =====
# Use this if your UniFi Access controller is on your local network
UNIFI_ACCESS_HOST=https://192.168.1.100:12443
UNIFI_ACCESS_USERNAME=your_unifi_username
UNIFI_ACCESS_PASSWORD=your_unifi_password

# ===== MODE 2: CLOUD ACCESS (via unifi.ui.com) =====
# Use this if you want to control UniFi Access remotely through the cloud
# UNIFI_ACCESS_HOST=https://api.ui.com
# UNIFI_API_KEY=your_api_key_from_account.ui.com
# UNIFI_SITE_ID=your_site_id_from_console_url

# Security Configuration
# Comma-separated list of Telegram user IDs allowed to use the bot
# To get your Telegram ID, message @userinfobot on Telegram
ALLOWED_TELEGRAM_USERS=123456789,987654321

# SSL Verification (set to false if using self-signed certificates)
VERIFY_SSL=true
