# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# UniFi Access Configuration
UNIFI_ACCESS_HOST=https://your-unifi-access-controller.local
UNIFI_ACCESS_USERNAME=your_unifi_username
UNIFI_ACCESS_PASSWORD=your_unifi_password

# Security Configuration
# Comma-separated list of Telegram user IDs allowed to use the bot
# To get your Telegram ID, message @userinfobot on Telegram
ALLOWED_TELEGRAM_USERS=123456789,987654321

# SSL Verification (set to false if using self-signed certificates)
VERIFY_SSL=true
